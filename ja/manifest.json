{
  "manifest_version": 3,
  "name": "NoKiridding",
  "version": "0.8.2",
  "description": "__MSG_extensionDescription__",
  "minimum_chrome_version": "120",
  "permissions": [
    "declarativeNetRequest",
    "webNavigation",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://google.com/search*",
        "https://www.google.co.jp/search*",
        "https://google.co.jp/search*"
      ],
      "js": [
        "i18n.js",
        "alphabet-blacklist.js",
        "protected-domains.js",
        "public-suffixes.js",
        "domain-protection.js",
        "core.js",
        "search-guard.js"
      ],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "block_idn",
        "enabled": true,
        "path": "rules/block-idn.json"
      },
      {
        "id": "protect_domains",
        "enabled": true,
        "path": "rules/protect-domains.json"
      }
    ]
  },
  "default_locale": "en"
}
